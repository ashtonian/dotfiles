# ~/.gitconfig.local - Machine-specific git configuration
# Copy this to ~/.gitconfig.local and customize for each machine.
# .gitconfig includes this file last, so its settings override the shared ones.

# GPG commit signing (get your key ID with: gpg --list-secret-keys --keyid-format long)
# [commit]
#     gpgsign = true
# [user]
#     signingkey = YOUR_GPG_KEY_ID
# [gpg]
#     program = /opt/homebrew/bin/gpg

# Machine-specific safe directories
# [safe]
#     directory = /path/to/your/repos

# GitHub credentials through gh. Copy these here rather than running
# `gh auth setup-git`, which writes through the ~/.gitconfig link into the
# tracked file. The empty helper clears osxkeychain for these hosts, which SSH
# sessions can't use while the login keychain is locked.
# [credential "https://github.com"]
#     helper =
#     helper = !/opt/homebrew/bin/gh auth git-credential
# [credential "https://gist.github.com"]
#     helper =
#     helper = !/opt/homebrew/bin/gh auth git-credential
