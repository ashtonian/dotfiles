{
  "$schema": "https://opencode.ai/config.json",

  // Local models only. Without this, OpenCode also loads its hosted providers,
  // and picking one of their free models would send code to a third party.
  "enabled_providers": ["homelab"],
  "share": "disabled",
  // Homebrew owns upgrades; a self-update would rewrite the Cellar copy.
  "autoupdate": false,

  "default_agent": "coordinator",
  // The GPU holds one model at a time and swaps on demand, so the title/summary
  // model is the same one the coordinator runs on: anything else forces a reload.
  "model": "homelab/qwen3.6-35b",
  "small_model": "homelab/qwen3.6-35b",

  "provider": {
    "homelab": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Homelab",
      // Kept out of this public repo: the gateway URL and a scoped virtual key.
      "options": {
        "baseURL": "{file:~/.local/share/opencode/homelab/base-url}",
        "apiKey": "{file:~/.local/share/opencode/homelab/litellm.key}"
      },
      // Limits match the server's -c; output leaves room for the prompt.
      "models": {
        "qwen3.6-35b": {
          "name": "Qwen3.6 35B-A3B",
          "tool_call": true,
          "limit": { "context": 65536, "output": 16384 }
        },
        "qwen3.6-35b-thinking": {
          "name": "Qwen3.6 35B-A3B (thinking)",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 65536, "output": 16384 }
        },
        "qwen3-coder-30b": {
          "name": "Qwen3 Coder 30B-A3B",
          "tool_call": true,
          "limit": { "context": 65536, "output": 16384 }
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (vision)",
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  }
}
