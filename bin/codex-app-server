#!/bin/zsh
#===============================================================================
# codex-app-server - the local Codex app-server behind gptmore and gptmax
#===============================================================================
#
# USAGE:
#   codex-app-server                 (run by the com.ashtonian.codex-remote-control LaunchAgent)
#   codex-app-server --print-endpoint
#
# Serves Codex sessions with remote control on its own Unix socket. The
# delegation policy reaches its sessions as it reaches every other: through
# the managed SessionStart hook that bin/dotfiles-agents installs.
#
# ONE-TIME SETUP (macOS privacy settings cannot be scripted):
#   System Settings > Privacy & Security > Full Disk Access > "+" > Cmd+Shift+G >
#   ~/.local/libexec/codex-stable/bin/codex   (run this script once first so it exists)
#
# Why a fixed path: see bin/stable-exec.
set -euo pipefail

endpoint="unix://${CODEX_HOME:-$HOME/.codex}/dotfiles-app-server.sock"
case ${1:-} in
	--print-endpoint) print -r -- "$endpoint"; exit 0 ;;
	'') ;;
	*) print -u2 'usage: codex-app-server [--print-endpoint]'; exit 64 ;;
esac

# The default socket belongs to Codex's managed daemon, whose clients require
# matching shared feature flags. Our remote sessions carry their own settings.
args=(app-server --remote-control --listen "$endpoint")

exec ${0:A:h}/stable-exec codex "${args[@]}"
