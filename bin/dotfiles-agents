#!/usr/bin/env bash
#===============================================================================
# dotfiles-agents - system configs that make Claude Code and Codex use bash,
#                   keep Claude Code's attribution out of commits and PRs, give
#                   every session the delegation policy, and run repo-guard in
#                   every Codex session
#===============================================================================
#
# USAGE:
#   dotfiles-agents install [claude|codex]   write both files, or one (asks for sudo when needed)
#   dotfiles-agents check [claude|codex] [--json]
#                                            compare the installed files with what install
#                                            writes; --json prints the result as a feature
#                                            check does (dotfiles apply and doctor run it)
#   dotfiles-agents uninstall [claude|codex] remove both files, or one
#
# The features agents.claude.bash and agents.codex.bash run these as their
# hooks: `dotfiles apply --sudo` installs a file whose check reports drift.
#
# Claude Code: a managed-settings drop-in sets CLAUDE_CODE_SHELL to a current
# bash and hides all attribution (`"attribution": false`, Claude Code 2.1.281
# or later): no Co-Authored-By trailer, PR line or session link. Managed
# settings outrank user and project settings, a CLAUDE.md rule cannot override
# their attribution, `env` merges per variable, and Claude Code never writes
# the file itself.
# Codex: it always runs the passwd login shell, with no setting to change it.
# Its system config layer turns shell snapshots off and marks every command
# shell with AGENT_SHELL; ~/.zshenv then hands the command to bash. Hooks in
# this layer are managed: they run without a trust prompt and a user config
# cannot turn them off. It registers repo-guard (~/.local/bin/repo-guard,
# feature agents.repo-guard) for the shell tool; a home without the feature
# passes. Codex treats a crashed hook as a non-blocking failure, so the
# command turns any exit other than 0 or 2 into a block. Commit and PR
# attribution has no local setting in Codex 0.171: the account's
# commit_attribution_enabled decides it (README: Agent shells).
# Both: a SessionStart hook prints the delegation policy
# (~/.config/agent-delegation/policy.md, feature agents.delegation) into the
# context of every top-level session, however it starts: a launcher, a bare
# `claude` or `codex`, `-p` or `exec`, a resume, /clear, or after compaction.
# Subagents start through SubagentStart instead, so they never see it. The hook
# reads the file each time, so a policy edit needs no reinstall.
#
# EXIT STATUS: 0 ok; 1 check found a missing or changed file (check --json
# exits 0 and says so in its result); 64 usage;
# 69 no bash 4 or later, or an unsupported OS; 73 a file this script did not
# write is in the way; 74 a file could not be written.
set -euo pipefail

root=${DOTFILES_SYSTEM_ROOT:-} # prefix for every system path; empty means /
case "$(uname -s)" in
    Darwin) claude_dir="$root/Library/Application Support/ClaudeCode/managed-settings.d" ;;
    Linux) claude_dir="$root/etc/claude-code/managed-settings.d" ;;
    *) printf 'dotfiles-agents: unsupported OS %s\n' "$(uname -s)" >&2; exit 69 ;;
esac
claude_file="$claude_dir/50-dotfiles.json"
codex_file="$root/etc/codex/config.toml"
marker='Managed by ~/.dotfiles (bin/dotfiles-agents)'

# die <status> <message>. Under check --json the message is the check's error
# result instead, since the engine reads a result from a check that exits 0.
die() {
    if [[ ${json:-0} == 1 ]]; then
        json_result error "$2"
        exit 0
    fi
    printf 'dotfiles-agents: %s\n' "$2" >&2
    exit "$1"
}

# json_result <state> <detail>: one feature check result (manifest.Check).
json_result() {
    local detail=${2//\\/\\\\}
    printf '{"state": "%s", "detail": "%s"}\n' "$1" "${detail//\"/\\\"}"
}

# A bash new enough for model-written commands. macOS's /bin/bash is 3.2.
agent_bash() {
    local candidate
    for candidate in "${HOMEBREW_PREFIX:-/opt/homebrew}/bin/bash" /home/linuxbrew/.linuxbrew/bin/bash /usr/bin/bash; do
        [[ -x "$candidate" ]] || continue
        if "$candidate" -c '(( BASH_VERSINFO[0] >= 4 ))' 2>/dev/null; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

# The SessionStart hook command for both harnesses. Plain stdout becomes
# session context in each; a home without the policy adds nothing.
policy_hook='cat ~/.config/agent-delegation/policy.md 2>/dev/null || true'

render_claude() {
    cat <<EOF
{
  "attribution": false,
  "env": {
    "CLAUDE_CODE_SHELL": "$1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$policy_hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
EOF
}

# The Codex hook command, run by the session's shell. Without the feature the
# call passes; with it, an exit other than 0 (allow or deny) or 2 (block)
# blocks, which Codex would otherwise let through.
# shellcheck disable=SC2016 # the hook's shell expands it, not this script
codex_guard='g="$HOME/.local/bin/repo-guard"; [ -e "$g" ] || [ -L "$g" ] || exit 0; /bin/bash "$g"; s=$?; case $s in 0|2) exit $s ;; esac; echo "repo-guard: exited $s; blocking the command" >&2; exit 2'

render_codex() {
    cat <<EOF
# $marker; edits here are replaced.
# ~/.codex/config.toml can still override any key for one user.

[features]
# A snapshot re-runs the login shell after ~/.zshenv has handed the command
# to bash, so snapshots stay off.
shell_snapshot = false

[shell_environment_policy]
# ~/.zshenv runs a command shell that carries this marker as bash.
set = { AGENT_SHELL = "codex" }

# repo-guard for the shell tool, which hooks see as Bash.
[[hooks.PreToolUse]]
matcher = "Bash"

[[hooks.PreToolUse.hooks]]
type = "command"
command = '$codex_guard'
timeout = 10

# The delegation policy, for every source: startup, resume, clear, compact, fork.
[[hooks.SessionStart]]

[[hooks.SessionStart.hooks]]
type = "command"
command = '$policy_hook'
timeout = 10
# Codex caps the context a hook adds; this leaves the policy ample room.
additionalContextLimit = 8000
EOF
}

# as_owner <path> <command...>: run directly when the path's parent is
# writable, otherwise through sudo.
as_owner() {
    local parent
    parent=$(dirname "$1")
    shift
    while [[ ! -e "$parent" ]]; do parent=$(dirname "$parent"); done
    if [[ -w "$parent" ]]; then "$@"; else sudo "$@"; fi
}

ours() { # ours <file>: the file is absent, or this script wrote it
    [[ ! -e "$1" ]] && return 0
    case "$1" in
        "$claude_file") return 0 ;; # its name is ours alone
        *) grep -qF "$marker" "$1" ;;
    esac
}

write() { # write <file> <content>
    local file="$1" content="$2" tmp
    ours "$file" || die 73 "$file was not written by dotfiles-agents; move it aside and run install again"
    if [[ -f "$file" && "$(cat "$file")" == "${content%$'\n'}" ]]; then
        printf 'ok         %s\n' "$file"
        return 0
    fi
    tmp=$(mktemp)
    printf '%s' "$content" > "$tmp"
    if ! { as_owner "$file" install -d -m 0755 "$(dirname "$file")" &&
        as_owner "$file" install -m 0644 "$tmp" "$file"; }; then
        rm -f -- "$tmp"
        die 74 "could not write $file"
    fi
    rm -f -- "$tmp"
    printf 'installed  %s\n' "$file"
}

# check_one <file> <content>: print the file's state, and record it for --json.
check_one() {
    local state=ok
    if [[ ! -f "$1" ]]; then
        state=missing
    elif [[ "$(cat "$1")" != "${2%$'\n'}" ]]; then
        state=changed
    fi
    checked+=("$state $1")
    [[ $json == 1 ]] || printf '%-10s %s\n' "$state" "$1"
    [[ $state == ok ]]
}

# check_json: the checked files as one feature check result (manifest.Check).
check_json() {
    local entry state=ok detail=""
    for entry in "${checked[@]}"; do
        case "${entry%% *}" in
            missing) state=missing; detail+="${detail:+; }${entry#* } is missing" ;;
            changed) [[ $state == missing ]] || state=drift; detail+="${detail:+; }${entry#* } differs from the repository" ;;
        esac
    done
    json_result "$state" "$detail"
}

remove() {
    [[ -e "$1" ]] || return 0
    ours "$1" || die 73 "$1 was not written by dotfiles-agents; leaving it"
    as_owner "$1" rm -f -- "$1"
    printf 'removed    %s\n' "$1"
}

usage='usage: dotfiles-agents install|check|uninstall [claude|codex] (check also takes --json)'
json=0
checked=()

main() {
    local command=${1:-} bash_path target status=0
    local -a targets=(claude codex)
    shift || true
    while (( $# )); do
        case "$1" in
            claude | codex) targets=("$1") ;;
            --json) [[ $command == check ]] || die 64 "$usage"; json=1 ;;
            *) die 64 "$usage" ;;
        esac
        shift
    done
    case "$command" in
        install | check)
            bash_path=$(agent_bash) || die 69 "no bash 4 or later found; install it with Homebrew"
            for target in "${targets[@]}"; do
                if [[ $command == install ]]; then
                    write "$(file_of "$target")" "$(render_of "$target" "$bash_path")"$'\n'
                else
                    check_one "$(file_of "$target")" "$(render_of "$target" "$bash_path")"$'\n' || status=1
                fi
            done
            if [[ $json == 1 ]]; then
                check_json
                return 0
            fi
            ;;
        uninstall)
            for target in "${targets[@]}"; do
                remove "$(file_of "$target")"
            done
            ;;
        *) die 64 "$usage" ;;
    esac
    return "$status"
}

file_of() { if [[ $1 == claude ]]; then printf '%s' "$claude_file"; else printf '%s' "$codex_file"; fi; }

render_of() { # render_of <target> <bash path>
    if [[ $1 == claude ]]; then render_claude "$2"; else render_codex; fi
}

main "$@"
