<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
================================================================================
com.dotfiles.sync.plist - Dotfiles Auto-Sync LaunchAgent
================================================================================

DESCRIPTION:
    Automatically commits and syncs dotfiles changes every 4 hours.
    Keeps your dotfiles in sync across machines without manual intervention.

WHAT IT DOES:
    1. Checks for network connectivity
    2. Installs missing packages, then the tools mise's configuration names
    3. Signs commits of tracked files and merges; scans outgoing dotfiles for secrets
    4. Verifies outgoing signatures, pushes, and checks GitHub verification

FREQUENCY:
    Every 4 hours (14400 seconds)

LOGS:
    - stdout: /tmp/dotfiles-sync.out
    - stderr: /tmp/dotfiles-sync.err
    - Full log: ~/.dotfiles/logs/sync.log

INSTALLATION:
    dotfiles apply, for the dotfiles.sync feature. Edit this template, not the
    installed copy: apply reloads the job when the template changes. A run of
    this job cannot reload itself, so its own change takes effect at the next
    apply outside it (the weekly update, or a terminal).

MANUAL COMMANDS:
    # Check its state:
    launchctl print gui/$(id -u)/com.dotfiles.sync

    # Manually trigger sync:
    launchctl kickstart gui/$(id -u)/com.dotfiles.sync

    # Or run directly:
    ~/.dotfiles/sync.sh sync

    # View recent logs:
    tail -50 ~/.dotfiles/logs/sync.log

    # Disable: add "dotfiles.sync" to [features] disable in
    # ~/.config/dotfiles/machine.toml, then run dotfiles apply.

================================================================================
-->
<plist version="1.0">
<dict>
    <!-- Unique identifier for this job -->
    <key>Label</key>
    <string>com.dotfiles.sync</string>

    <!-- Run directly, not through a login shell: path_helper would move /usr/bin
         ahead of the PATH below. The script's bash (Homebrew's) is then the
         job's macOS privacy identity, which every step inherits: Go's caches
         on an external volume need one Removable Volumes grant to it. Under
         /bin/bash, an Apple binary, macOS asks for each tool instead (brew's
         ruby, go), and those change with every Homebrew and Go update. -->
    <key>ProgramArguments</key>
    <array>
        <string>$HOME/.dotfiles/sync.sh</string>
        <string>sync</string>
    </array>

    <!-- Run every 4 hours (14400 seconds) -->
    <key>StartInterval</key>
    <integer>14400</integer>

    <!-- Also run when first loaded -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Log files -->
    <key>StandardOutPath</key>
    <string>/tmp/dotfiles-sync.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/dotfiles-sync.err</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>$HOME</string>
        <key>DOTFILES_DIR</key>
        <string>$HOME/.dotfiles</string>
    </dict>

    <!-- Run at lower priority (don't impact user experience) -->
    <key>Nice</key>
    <integer>10</integer>

    <!-- Background process -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
