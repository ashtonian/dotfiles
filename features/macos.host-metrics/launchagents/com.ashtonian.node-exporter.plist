<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  node_exporter on 127.0.0.1 at the host_metrics.node_exporter_port setting,
  serving the host-metrics textfiles too, for otel-agent's collector to scrape
  (bin/host-metrics node-exporter, docs/HOST-METRICS.md). A port another
  process holds stops it, and launchd tries again every 60 s.
  dotfiles apply installs it for the macos.host-metrics feature, with $HOME replaced.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ashtonian.node-exporter</string>
    <key>ProgramArguments</key>
    <array>
        <string>$HOME/.dotfiles/bin/host-metrics</string>
        <string>node-exporter</string>
    </array>
    <key>WorkingDirectory</key>
    <string>$HOME</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/host-metrics/node-exporter.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/host-metrics/node-exporter.err</string>
</dict>
</plist>
