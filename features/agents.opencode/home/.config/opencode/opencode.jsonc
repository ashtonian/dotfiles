{
  "$schema": "https://opencode.ai/config.json",

  // Local models only. Without this, OpenCode also loads its hosted providers,
  // and picking one of their free models would send code to a third party.
  "enabled_providers": ["homelab"],
  "share": "disabled",
  // Homebrew owns upgrades; a self-update would rewrite the Cellar copy.
  "autoupdate": false,
  // The shell tool runs `<shell> -c`. Model-written commands are bash, as in
  // Claude Code's Bash tool; the service sets BASH_ENV to the shared environment.
  "shell": "/opt/homebrew/bin/bash",

  // Telemetry to the local collector (bin/otel-agent, docs/AGENT-TELEMETRY.md),
  // which forwards to the cluster. The 1.x line is the one built for OpenCode V1.
  // Traces are off because the cluster has no trace backend; prompts stay out of
  // the logs by default.
  "plugin": [
    ["@devtheops/opencode-plugin-otel@1.5.1", {
      "enabled": true,
      "endpoint": "http://127.0.0.1:4318",
      "protocol": "http/protobuf",
      "metricsTemporality": "cumulative",
      "disabledTraces": ["session", "llm", "tool"]
    }]
  ],

  // No approval prompts, matching the Claude Code fleet's bypassed permissions.
  // The defaults already allow every tool inside the project; this also allows
  // paths outside it and identical repeated tool calls, which otherwise ask.
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  },

  "default_agent": "coordinator",
  // Both aliases are the one model the gateway keeps resident, so switching
  // between them never reloads the GPU. The default thinks (the build and plan
  // agents code on it); -fast turns thinking off for the coordinator and for
  // titles and summaries, where a reasoning trace at ~30 tok/s is pure latency.
  "model": "homelab/qwen3.8-27b",
  "small_model": "homelab/qwen3.8-27b-fast",

  "provider": {
    "homelab": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Homelab",
      // Kept out of this public repo: the gateway URL and a scoped virtual key.
      // headerTimeout: the server sends no headers until prefill ends, and a
      // cold prompt filling the whole window takes ~11 minutes on the local card
      // (OpenCode's default is 5); 30 minutes leaves room to queue behind another.
      "options": {
        "baseURL": "{file:~/.local/share/opencode/homelab/base-url}",
        "apiKey": "{file:~/.local/share/opencode/homelab/litellm.key}",
        "headerTimeout": 1800000
      },
      // Limits match the server: the model's native 262,144-token window.
      // options are sent as request fields; chat_template_kwargs is what turns
      // Qwen's thinking on or off per request. interleaved returns earlier
      // reasoning as reasoning_content, which the chat template preserves.
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (thinking)",
          "tool_call": true,
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
          "options": { "chat_template_kwargs": { "enable_thinking": true } }
        },
        "qwen3.8-27b-fast": {
          "id": "qwen3.8-27b",
          "name": "Qwen3.8 27B (no thinking)",
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
          // Qwen's non-thinking sampling; the server defaults to its thinking set.
          "options": {
            "chat_template_kwargs": { "enable_thinking": false },
            "temperature": 0.7,
            "top_p": 0.8
          }
        }
      }
    }
  }
}
