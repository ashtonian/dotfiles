<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Every day at 04:15, deletes agent scratch unused for 7 days and caches unused
  for 14, prunes the pnpm stores, and caps the dotfiles LaunchAgents' logs at
  1 MiB (bin/disk-hygiene; its header lists every DISK_HYGIENE_* setting). A
  run missed while the Mac sleeps happens at wake.
  $HOME is replaced with the actual path by dotfiles-install-launchagents.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ashtonian.disk-hygiene</string>
    <key>ProgramArguments</key>
    <array>
        <string>$HOME/.dotfiles/bin/disk-hygiene</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>DISK_HYGIENE_SCRATCH_DAYS</key>
        <string>7</string>
        <key>DISK_HYGIENE_CACHE_DAYS</key>
        <string>14</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/disk-hygiene/disk-hygiene.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/disk-hygiene/disk-hygiene.err</string>
</dict>
</plist>
