<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local OpenTelemetry Collector: receives Claude Code, Codex and OpenCode
  telemetry on 127.0.0.1 and forwards it to the cluster gateway. Runs through
  bin/otel-agent serve (see docs/AGENT-TELEMETRY.md).
  $HOME is replaced with the actual path by dotfiles-install-launchagents.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ashtonian.otel-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>$HOME/.dotfiles/bin/otel-agent</string>
        <string>serve</string>
    </array>
    <key>WorkingDirectory</key>
    <string>$HOME</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/otel-agent/collector.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/otel-agent/collector.stderr.log</string>
</dict>
</plist>
