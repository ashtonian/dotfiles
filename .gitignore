Brewfile.lock.json
Brewfile.local
*.DS_Store
*.bak
*.swp
*.swo
*~
.env
.env.*
logs/

# Machine-generated zsh completion cache (regenerated each shell; never track —
# it would otherwise be auto-committed and pushed as per-machine junk)
.zcompdump*
*.zwc

# === Secrets & credentials =================================================
# This repo auto-commits and pushes to a PUBLIC GitHub remote every few hours
# (see sync.sh / launchagents). Anything tracked becomes world-readable, so keep
# credential material and machine-local overrides OUT by default.
*.local
# Keep committed local-override templates.
!*.local.example
# Features that install into ~/.local keep that tree tracked.
!features/*/home/.local/
.envrc
*.pem
*.key
*.crt
*.p12
*.pfx
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
*.gpg
*.asc
.netrc
.npmrc
.pypirc
credentials
*credentials*
kubeconfig
*.kubeconfig
service-account*.json
*-key.json
.secret
*.secret
secrets.*

# The retired stow tree. Anything still under it is a file a tool wrote through
# an old directory link, such as gh's hosts.yml with its OAuth token, which
# `dotfiles apply` moves home. Never track it in this PUBLIC repo.
/stow/

# What tools write next to their config. apply links each file on its own, so
# these land in $HOME, never here; ignored in case a link ever folds again.
features/tool.gh/home/.config/gh/hosts.yml
features/agents.opencode/home/.config/opencode/node_modules/
features/agents.opencode/home/.config/opencode/package.json
features/agents.opencode/home/.config/opencode/bun.lock

__pycache__/
*.py[cod]
