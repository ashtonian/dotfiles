Brewfile.lock.json
Brewfile.local
*.DS_Store
*.bak
*.swp
*.swo
*~
.env
.env.*
logs/

# Machine-generated zsh completion cache (regenerated each shell; never track —
# it would otherwise be auto-committed and pushed as per-machine junk)
.zcompdump*
*.zwc

# === Secrets & credentials =================================================
# This repo auto-commits and pushes to a PUBLIC GitHub remote every few hours
# (see sync.sh / launchagents). Anything tracked becomes world-readable, so keep
# credential material and machine-local overrides OUT by default.
*.local
# Keep committed local-override templates.
!*.local.example
# Stow packages that install into ~/.local keep that tree tracked.
!stow/*/.local/
.envrc
*.pem
*.key
*.crt
*.p12
*.pfx
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
*.gpg
*.asc
.netrc
.npmrc
.pypirc
credentials
*credentials*
kubeconfig
*.kubeconfig
service-account*.json
*-key.json
.secret
*.secret
secrets.*

# gh CLI writes its oauth_token into hosts.yml on `gh auth login` -- it must
# never land in this PUBLIC repo. Untracked; keep it local only.
stow/gh/.config/gh/hosts.yml

# OpenCode installs plugin dependencies next to its config, which stow links
# into this repo; they are machine-local build output.
stow/opencode/.config/opencode/node_modules/
stow/opencode/.config/opencode/package.json
stow/opencode/.config/opencode/package-lock.json
stow/opencode/.config/opencode/bun.lock

__pycache__/
*.py[cod]
